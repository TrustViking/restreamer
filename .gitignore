########################################
# Secrets / credentials (НЕ КОМИТИТЬ)
########################################
secrets/
secrets/.env
!secrets/.env.example
secrets/token.json
secrets/credentials.json
*.env
# если хочешь хранить шаблон:
!.env.example

# Google OAuth / API
credentials*.json
credentials_bot.json
.credentials_bot.json
client_secret*.json
*oauth*.json
*service_account*.json
*service-account*.json
streamertg-*.json

# Keys / certs
*.pem
*.key
*.p12

########################################
# Local helper materials
########################################
_HELP/
docs_example/

########################################
# Python / caches
########################################
__pycache__/
*.py[cod]
*.pyd
*.so

.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
pip-wheel-metadata/
*.egg-info/
.eggs/
build/
dist/

########################################
# Virtual environments
########################################
.venv/
venv/
ENV/
.venv_*/
# на всякий случай (если вдруг создашь так)
.venv-*/
# если используешь poetry:
.poetry/

########################################
# Logs / temp / outputs
########################################
*.log
logs/
tmp/
temp/
out/
output/
outputs/
downloads/
data/
docs/
image/

########################################
# IDE / OS / local workspace stuff
########################################
.vscode/
*.code-workspace

Thumbs.db
Desktop.ini
.DS_Store

########################################
